{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "cbfc-tracker",
  "post": {
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "server": {},
  "permissions": {
    "redis": true,
    "reddit": true
  },
  "settings": {
    "subreddit": {
      "postTitle": {
        "type": "string",
        "label": "Title",
        "helpText": "Title for new tracker posts",
        "defaultValue": "🎬 CBFC Certificates: Search & Watchlist (Unofficial)"
      },
      "archive": {
        "type": "boolean",
        "label": "Daily archive (00:00 IST)",
        "helpText": "Daily post of new certificates",
        "defaultValue": true
      },
      "trackerPost": {
        "type": "string",
        "label": "Source post ID",
        "helpText": "Optional: post to read new certificates from",
        "placeholder": "123456",
        "defaultValue": "",
        "validationEndpoint": "/internal/settings/source-post"
      },
      "initialData": {
        "type": "paragraph",
        "label": "Initial data (JSON)",
        "helpText": "Older certificates; clear after import",
        "defaultValue": "",
        "validationEndpoint": "/internal/settings/initial-data"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Add CBFC Tracker",
        "description": "CBFC search and watchlist",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/on/menu/new-post"
      },
      {
        "label": "Sync CBFC data",
        "description": "Read the source post now",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/on/menu/sync"
      }
    ]
  },
  "triggers": {
    "onPostUpdate": "/internal/on/post-update"
  },
  "scheduler": {
    "tasks": {
      "sync": {
        "endpoint": "/internal/scheduler/sync",
        "cron": "*/15 * * * *"
      }
    }
  },
  "dev": {
    "subreddit": "cbfc_tracker_dev"
  },
  "scripts": {
    "dev": "npm run watch"
  }
}
