{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "cbfc-tracker",
  "post": {
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "server": {},
  "permissions": {
    "redis": true,
    "reddit": true
  },
  "settings": {
    "subreddit": {
      "postTitle": {
        "type": "string",
        "label": "Title",
        "helpText": "Title of the post created by \"Add CBFC Tracker\"",
        "defaultValue": "🎬 CBFC Tracker"
      },
      "dailyPostTime": {
        "type": "select",
        "label": "Archive time (IST)",
        "helpText": "Each day at this time, a new post lists every certificate not archived yet",
        "options": [
          {"label": "Off", "value": "off"},
          {"label": "00:00", "value": "00:00"},
          {"label": "06:00", "value": "06:00"},
          {"label": "12:00", "value": "12:00"},
          {"label": "18:00", "value": "18:00"},
          {"label": "21:00", "value": "21:00"}
        ],
        "defaultValue": "00:00"
      },
      "trackerPost": {
        "type": "string",
        "label": "Source post",
        "helpText": "Link or ID of the post cbfc.js keeps updating",
        "defaultValue": ""
      },
      "initialData": {
        "type": "paragraph",
        "label": "Initial data (JSON)",
        "helpText": "Past certificates, loaded once when saved",
        "defaultValue": ""
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Add CBFC Tracker",
        "description": "Watchlist and search for CBFC certificates",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/on/menu/new-post"
      }
    ]
  },
  "dev": {
    "subreddit": "cbfc_tracker_dev"
  },
  "scripts": {
    "dev": "npm run watch"
  }
}
