{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "dev": {
    "subreddit": "cbfc_tracker_dev"
  },
  "menu": {
    "items": [
      {
        "description": "Open or create tracker",
        "endpoint": "/internal/on/menu/new-post",
        "forUserType": "moderator",
        "label": "Add CBFC Tracker",
        "location": "subreddit"
      }
    ]
  },
  "name": "cbfc-tracker",
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "post": {
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "scheduler": {
    "tasks": {
      "sync": {
        "cron": "*/15 * * * *",
        "endpoint": "/internal/scheduler/sync"
      }
    }
  },
  "scripts": {
    "dev": "npm run watch"
  },
  "server": {},
  "settings": {
    "subreddit": {
      "initialData": {
        "defaultValue": "",
        "helpText": "One-time import; clear after",
        "label": "Initial data (JSON)",
        "type": "paragraph",
        "validationEndpoint": "/internal/settings/initial-data"
      },
      "postTitle": {
        "defaultValue": "🎬 CBFC Certificates: Search & Watchlist (Unofficial)",
        "helpText": "Shown as the post title",
        "label": "Title",
        "type": "string"
      },
      "trackerPost": {
        "defaultValue": "",
        "helpText": "Optional: post to read new certificates from",
        "label": "Source post ID",
        "placeholder": "123456",
        "type": "string",
        "validationEndpoint": "/internal/settings/source-post"
      }
    }
  },
  "triggers": {
    "onPostUpdate": "/internal/on/post-update"
  }
}
